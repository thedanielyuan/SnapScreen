{
  "name": "snapscreen",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "build:extension-native": "tsc --noEmit && vite build --config vite.native.config.ts",
    "test:browser": "node scripts/extension-smoke.mjs",
    "test:browser-native": "node --test scripts/extension-native-package.node-test.mjs && node scripts/extension-native-smoke.mjs",
    "build:native": "node scripts/native-companion-build.mjs",
    "test:native": "node scripts/native-companion-test.mjs",
    "test:native-live": "node scripts/native-companion-live-test.mjs",
    "package:native": "node scripts/native-companion-package.mjs",
    "test:native-packaged": "node scripts/native-companion-packaged-test.mjs",
    "experiment:native-packaged": "node scripts/native-companion-acceptance.mjs",
    "install:native": "node scripts/native-companion-install.mjs",
    "build:native-prototype": "node scripts/native-phase1-build.mjs && sh experiments/native-phase1/native/build.sh",
    "test:native-prototype": "node --test experiments/native-phase1/extension/*.node-test.mjs && experiments/native-phase1/build/SnapScreenPhase1.app/Contents/MacOS/SnapScreenPhase1 --self-test",
    "experiment:native": "node scripts/native-phase1-session.mjs",
    "package": "node scripts/package-extension.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
