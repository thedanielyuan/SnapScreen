{
  "manifest_version": 3,
  "name": "SnapScreen",
  "description": "Snip the current tab and get answers in the SnapScreen macOS companion",
  "homepage_url": "https://github.com/thedanielyuan/SnapScreen",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage", "nativeMessaging"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "optional_host_permissions": ["file:///*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https://api.anthropic.com data:; object-src 'none'; base-uri 'none'"
  },
  "action": {
    "default_title": "SnapScreen – Snip and analyze",
    "default_icon": {
      "16": "src/assets/icons/icon16.png",
      "24": "src/assets/icons/icon24.png",
      "32": "src/assets/icons/icon32.png",
      "48": "src/assets/icons/icon48.png",
      "128": "src/assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "32": "src/assets/icons/icon32.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker-native.ts",
    "type": "module"
  },
  "options_page": "src/options/options-native.html",
  "commands": {
    "snip": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Enter snip mode"
    }
  }
}
