#!/bin/sh
# Refuse to push a branch that is missing commits from main on the remote. PRs merge on GitHub,
# so local main falls behind, and a branch cut from it conflicts with whatever merged since.
# main's ruleset also only merges up-to-date PRs, so a stale branch can't merge as is.
#
# Enable once per clone: git config core.hooksPath .githooks
# Skip once:             git push --no-verify

remote=$1
updates=$(cat)
[ -n "$updates" ] || exit 0

# Offline, or no main on this remote: let the push itself decide.
git fetch --quiet "$remote" main 2>/dev/null || exit 0
main=$(git rev-parse --verify --quiet FETCH_HEAD) || exit 0

status=0
while read -r _ local_oid remote_ref remote_oid; do
  case $remote_ref in
    refs/heads/main) continue ;;
    refs/heads/*) ;;
    *) continue ;;
  esac
  case $local_oid in *[!0]*) ;; *) continue ;; esac # deleting the branch
  git merge-base --is-ancestor "$main" "$local_oid" && continue

  case $remote_oid in
    *[!0]*) update="git merge $remote/main" ;; # already pushed: merge, so no force-push
    *) update="git rebase $remote/main" ;;
  esac
  echo "pre-push: ${remote_ref#refs/heads/} is behind $remote/main, so its PR can't merge as is and may conflict." >&2
  echo "Update it, rerun the checks, then push again: $update" >&2
  status=1
done <<EOF
$updates
EOF
exit $status
